                CargarModelos();

                bool selected = false;
                try { selected = SelectModeloInGrid(idModelo); } catch { selected = false; }
                if (!selected)
                    pendingModeloSeleccionarId = idModelo;
            }
            catch { }
        }

        // Helper that selects a marca row by id, scrolls into view and focuses the grid
        private bool SelectMarcaInGrid(int idMarca)
        {
            var dgv = BuscarControlEnTab("dgvMarcas", "MARCAS") as DataGridView;
            if (dgv == null) return false;

            for (int i = 0; i < dgv.Rows.Count; i++)
            {
                var row = dgv.Rows[i];
                if (row.Cells["colIdMarca"].Value != null && Convert.ToInt32(row.Cells["colIdMarca"].Value) == idMarca)
                {
                    dgv.ClearSelection();
                    row.Selected = true;
                    try { dgv.FirstDisplayedScrollingRowIndex = Math.Max(0, i - 2); } catch { }
                    try { dgv.CurrentCell = row.Cells[0]; } catch { }
                    try { dgv.Focus(); } catch { }

                    // Load details into form fields
                    CargarDatosMarca(idMarca);
                    return true;
                }
            }

            return false;
        }

        // Helper that selects a modelo row by id, scrolls into view and focuses the grid
        private bool SelectModeloInGrid(int idModelo)
        {
            var dgv = BuscarControlEnTab("dgvModelos", "MODELOS") as DataGridView;
            if (dgv == null) return false;

            for (int i = 0; i < dgv.Rows.Count; i++)
            {
                var row = dgv.Rows[i];
                if (row.Cells["colIdModelo"].Value != null && Convert.ToInt32(row.Cells["colIdModelo"].Value) == idModelo)
                {
                    dgv.ClearSelection();
                    row.Selected = true;
                    try { dgv.FirstDisplayedScrollingRowIndex = Math.Max(0, i - 2); } catch { }
                    try { dgv.CurrentCell = row.Cells[0]; } catch { }
                    try { dgv.Focus(); } catch { }

                    CargarDatosModelo(idModelo);
                    return true;
                }
            }

            return false;
        }
    }
