        // ===== MÉTODOS AUXILIARES =====
        private Control BuscarControlEnTab(string nombreControl, string nombreTab)
        {
            var tabControl = this.Controls.Find("tabControl", true).FirstOrDefault() as TabControl;
            if (tabControl == null) return null;

            TabPage tab = null;
            foreach (TabPage tp in tabControl.TabPages)
            {
                if (tp.Text.Contains(nombreTab))
                {
                    tab = tp;
                    break;
                }
            }

            if (tab == null) return null;

            return BuscarControlRecursivo(tab, nombreControl);
        }

        private Control BuscarControlRecursivo(Control parent, string nombre)
        {
            if (parent.Name == nombre)
                return parent;

            foreach (Control child in parent.Controls)
            {
                var found = BuscarControlRecursivo(child, nombre);
                if (found != null)
                    return found;
            }

            return null;
        }

        // ===== MÉTODOS DE CARGA =====
        private void CargarProcedencias()
        {
            try
            {
                var cboProcedencia = BuscarControlEnTab("cboProcedenciaMarca", "MARCAS") as ComboBox;
                if (cboProcedencia == null) return;

                var procedencias = ProcedenciaCln.listar();
                cboProcedencia.DataSource = procedencias;
                cboProcedencia.DisplayMember = "descripcion";
                cboProcedencia.ValueMember = "id";
                cboProcedencia.SelectedIndex = -1;
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error al cargar procedencias: {ex.Message}", "Error",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void CargarMarcasCombo()
        {
