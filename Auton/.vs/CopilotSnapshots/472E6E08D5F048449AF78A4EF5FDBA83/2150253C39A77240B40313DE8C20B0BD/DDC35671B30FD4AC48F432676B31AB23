        public FrmGestionarMarcasModelos()
        {
            InitializeComponent();
            // Build UI immediately so external callers can manipulate controls before ShowDialog
            ConfigurarFormulario();

            // Load data and validate authentication when the form is shown
            this.Shown += (s, ev) =>
            {
                // Validar autenticación
                if (Util.usuario == null)
                {
                    MessageBox.Show("⚠️ Debe iniciar sesión para gestionar marcas y modelos.",
                        "Acceso Restringido", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    this.Close();
                    return;
                }

                CargarProcedencias();
                CargarMarcasCombo();
                CargarMarcas();
                CargarModelos();

                // If an external caller requested a preselection before showing, apply it now
                try
                {
                    if (pendingMarcaSeleccionarId > 0)
                    {
                        SelectMarcaInGrid(pendingMarcaSeleccionarId);
                        pendingMarcaSeleccionarId = 0;
                    }

                    if (pendingModeloSeleccionarId > 0)
                    {
                        SelectModeloInGrid(pendingModeloSeleccionarId);
                        pendingModeloSeleccionarId = 0;
                    }
                }
                catch { }
            };
        }

