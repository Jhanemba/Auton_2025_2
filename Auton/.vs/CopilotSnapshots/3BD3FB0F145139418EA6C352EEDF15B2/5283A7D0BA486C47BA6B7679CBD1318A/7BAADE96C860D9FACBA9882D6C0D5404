        private void ConfigurarVelocidades(string tipoTransmision)
        {
            // Ensure there is a placeholder label to show a dash for CVT (so NumericUpDown doesn't display a numeric minimum)
            Label lblPlaceholder = null;
            try
            {
                var found = this.Controls.Find("lblVelocidadesPlaceholder", true);
                if (found != null && found.Length > 0 && found[0] is Label)
                    lblPlaceholder = (Label)found[0];
            }
            catch { }

            if (lblPlaceholder == null)
            {
                lblPlaceholder = new Label
                {
                    Name = "lblVelocidadesPlaceholder",
                    Location = nudVelocidades.Location,
                    Size = nudVelocidades.Size,
                    Font = new Font("Segoe UI", 10F),
                    TextAlign = ContentAlignment.MiddleCenter,
                    ForeColor = Color.Gray,
                    BackColor = Color.Transparent,
                    Visible = false
                };
                // Add to same parent so it scrolls/moves together
                nudVelocidades.Parent.Controls.Add(lblPlaceholder);
                lblPlaceholder.BringToFront();
            }

            switch (tipoTransmision)
            {
                case "Manual":
                    nudVelocidades.Visible = true;
                    lblPlaceholder.Visible = false;
                    nudVelocidades.Minimum = 4;
                    nudVelocidades.Maximum = 6;
                    nudVelocidades.Enabled = true;
                    {
                        decimal min = nudVelocidades.Minimum;
                        decimal max = nudVelocidades.Maximum;
                        decimal val = 5m;
                        if (val < min) val = min;
                        if (val > max) val = max;
                        nudVelocidades.Value = val;
                    }
                    lblInfoVelocidades.Text = "(4-6 velocidades)";
                    lblInfoVelocidades.ForeColor = Color.FromArgb(40, 167, 69);
                    break;

                case "Automática":
                    nudVelocidades.Visible = true;
                    lblPlaceholder.Visible = false;
                    nudVelocidades.Minimum = 4;
                    nudVelocidades.Maximum = 10;
                    nudVelocidades.Enabled = true;
                    {
                        decimal min = nudVelocidades.Minimum;
                        decimal max = nudVelocidades.Maximum;
                        decimal val = 6m;
                        if (val < min) val = min;
                        if (val > max) val = max;
                        nudVelocidades.Value = val;
                    }
                    lblInfoVelocidades.Text = "(4-10 velocidades)";
                    lblInfoVelocidades.ForeColor = Color.FromArgb(0, 123, 255);
                    break;

                case "CVT":
                    // For CVT we show a placeholder dash instead of a numeric value
                    nudVelocidades.Visible = false;
                    nudVelocidades.Enabled = false;
                    lblPlaceholder.Text = "-";
                    lblPlaceholder.Visible = true;
                    lblInfoVelocidades.Text = "(Sin velocidades)";
                    lblInfoVelocidades.ForeColor = Color.FromArgb(108, 117, 125);
                    break;

                case "Semiautomática":
                case "Doble Embrague":
                    nudVelocidades.Visible = true;
                    lblPlaceholder.Visible = false;
                    nudVelocidades.Minimum = 6;
                    nudVelocidades.Maximum = 8;
                    nudVelocidades.Enabled = true;
                    {
                        decimal min = nudVelocidades.Minimum;
                        decimal max = nudVelocidades.Maximum;
                        decimal val = 7m;
                        if (val < min) val = min;
                        if (val > max) val = max;
                        nudVelocidades.Value = val;
                    }
                    lblInfoVelocidades.Text = "(6-8 velocidades)";
                    lblInfoVelocidades.ForeColor = Color.FromArgb(255, 193, 7);
                    break;

                default:
                    nudVelocidades.Visible = true;
                    lblPlaceholder.Visible = false;
                    nudVelocidades.Enabled = false;
                    lblInfoVelocidades.Text = "Seleccione transmisión";
                    lblInfoVelocidades.ForeColor = Color.Gray;
                    break;
            }
        }

        // Abre el navegador con la búsqueda: ¿Qué generación es el [Marca] [Modelo] [Año]? (ahora intenta sugerir automáticamente)
        private async void BtnBuscarGeneracion_Click(object sender, EventArgs e)
        {
            try
            {
                string marca = cboMarca != null ? cboMarca.Text.Trim() : string.Empty;
                string modelo = cboModelo != null ? cboModelo.Text.Trim() : string.Empty;
                int anio = nudAnio != null ? (int)nudAnio.Value : DateTime.Now.Year;

                if (string.IsNullOrWhiteSpace(marca) && string.IsNullOrWhiteSpace(modelo))
                {
                    MessageBox.Show("⚠️ Debe especificar al menos la Marca o el Modelo para realizar la búsqueda.", "Información", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    return;
                }

                btnBuscarGeneracion.Enabled = false;
                var originalCursor = this.Cursor;
                this.Cursor = Cursors.WaitCursor;

                string sugerencia = await ObtenerSugerenciaGeneracionAsync(marca, modelo, anio);

                this.Cursor = originalCursor;
                btnBuscarGeneracion.Enabled = true;

                if (!string.IsNullOrWhiteSpace(sugerencia))
                {
                    var dr = MessageBox.Show($"Sugerencia encontrada:\n\n{sugerencia}\n\n¿Desea usarla como Generación?", "Sugerencia de Generación", MessageBoxButtons.YesNo, MessageBoxIcon.Question);
                    if (dr == DialogResult.Yes)
                    {
                        txtGeneracion.Text = sugerencia;
                    }
                }
                else
                {
                    // Fallback: abrir navegador con la búsqueda si no se obtuvo sugerencia
                    string query = $"¿Qué generación es el {marca} {modelo} {anio}?".Trim();
                    string url = "https://www.google.com/search?q=" + Uri.EscapeDataString(query);
                    var psi = new ProcessStartInfo { FileName = url, UseShellExecute = true };
                    Process.Start(psi);
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"❌ No se pudo completar la operación:\n{ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                btnBuscarGeneracion.Enabled = true;
                this.Cursor = Cursors.Default;
            }
        }

        // Consulta DuckDuckGo Instant Answer API y aplica heurísticas para extraer una probable generación
        private async Task<string> ObtenerSugerenciaGeneracionAsync(string marca, string modelo, int anio)
        {
            string q = $"qué generación es {marca} {modelo} {anio}".Trim();
            string requestUrl = "https://api.duckduckgo.com/?q=" + Uri.EscapeDataString(q) + "&format=json&no_html=1&skip_disambig=1&kl=es-es";

            using (var http = new HttpClient())
            {
                http.Timeout = TimeSpan.FromSeconds(10);
                string json = await http.GetStringAsync(requestUrl);

                // Extraer AbstractText
                string texto = ExtractJsonStringValue(json, "AbstractText");

                // Si no hay AbstractText, buscar otros textos en RelatedTopics
                if (string.IsNullOrWhiteSpace(texto))
                {
                    // Extraer todos los "Text" de RelatedTopics
                    var matches = Regex.Matches(json, "\"Text\"\\s*:\\s*\"(?<t>(?:\\\\.|[^\\\"])*?)\"");
                    var sb = new StringBuilder();
                    foreach (Match m in matches)
                    {
                        string t = Regex.Unescape(m.Groups["t"].Value);
                        if (!string.IsNullOrWhiteSpace(t))
                            sb.AppendLine(t);
                    }
                    texto = sb.ToString();
                }

                if (string.IsNullOrWhiteSpace(texto))
                    return null;

                // Aplicar heurísticas para detectar generación
                string sugerencia = DetectGenerationFromText(texto);
                if (!string.IsNullOrWhiteSpace(sugerencia))
                    return sugerencia;

                // Como último recurso: devolver la primera frase truncada como sugerencia
                var first = texto.Split(new[] { '.', '\n' }, StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
                if (!string.IsNullOrWhiteSpace(first))
                {
                    // Limitar a 50 caracteres
                    string trimmed = first.Trim();
                    if (trimmed.Length > 50) trimmed = trimmed.Substring(0, 50) + "...";
                    return trimmed;
                }

                return null;
            }
        }

        private static string ExtractJsonStringValue(string json, string key)
        {
            try
            {
                var rx = new Regex("\"" + Regex.Escape(key) + "\"\\s*:\\s*\"(?<t>(?:\\\\.|[^\\\"])*?)\"");
                var m = rx.Match(json);
                if (m.Success)
                {
                    return Regex.Unescape(m.Groups["t"].Value);
                }
            }
            catch { }
            return null;
        }

        private static string DetectGenerationFromText(string text)
        {
            if (string.IsNullOrWhiteSpace(text)) return null;
            // Normalize
            string t = text.Replace('\n', ' ').Replace('\r', ' ');

            // Common patterns (English & Spanish)
            var patterns = new[]
            {
                // 3rd generation, 2nd generation
                new Regex("\\b(\\d{1,2})(?:st|nd|rd|th)\\s+generation\\b", RegexOptions.IgnoreCase),
                // Generation 3, generación 3, generación III
                new Regex("\\b(generation|generaci[oó]n)\\s+([IVXLCM]+|\\d{1,2}|primera|segunda|tercera|cuarta|quinta|sexta|septima|s[eé]ptima|octava|novena|decima|d[eé]cima)\\b", RegexOptions.IgnoreCase),
                // Gen 3, Gen. 3
                new Regex("\\bGen\.?\\s*[:\\-]?\\s*([IVXLCM]+|\\d{1,2})\\b", RegexOptions.IgnoreCase),
                // Mark II, Mk II
                new Regex("\\b(Mark|Mk)\\.?\\s+([IVXLCM]+|\\d{1,2})\\b", RegexOptions.IgnoreCase),
                // Roman numerals standalone like 'III generation' or 'III gen'
                new Regex("\\b([IVXLCM]{1,4})\\b\\s*(?:generation|gen|generaci[oó]n)?", RegexOptions.IgnoreCase)
            };

            foreach (var rx in patterns)
            {
                var m = rx.Match(t);
                if (m.Success)
                {
                    // Try to build a readable suggestion
                    if (m.Groups.Count >= 3 && !string.IsNullOrWhiteSpace(m.Groups[2].Value))
                        return NormalizeGenerationToken(m.Groups[2].Value);
                    // Some patterns have the token in group 1
                    if (m.Groups.Count >= 2 && !string.IsNullOrWhiteSpace(m.Groups[1].Value))
                        return NormalizeGenerationToken(m.Groups[1].Value);
                }
            }

            // Also try to find words like 'tercera generación', 'segunda generación'
            var ordinals = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                {"primera","1ª generación"}, {"segunda","2ª generación"}, {"tercera","3ª generación"}, {"cuarta","4ª generación"},
                {"quinta","5ª generación"}, {"sexta","6ª generación"}, {"séptima","7ª generación"}, {"septima","7ª generación"},
                {"octava","8ª generación"}, {"novena","9ª generación"}, {"décima","10ª generación"}, {"decima","10ª generación"}
            };

            foreach (var kv in ordinals)
            {
                if (t.IndexOf(kv.Key, StringComparison.OrdinalIgnoreCase) >= 0 && t.IndexOf("generaci", StringComparison.OrdinalIgnoreCase) >= 0)
                    return kv.Value;
            }

            return null;
        }

        private static string NormalizeGenerationToken(string token)
        {
            if (string.IsNullOrWhiteSpace(token)) return null;
            token = token.Trim();
            // Roman numerals to number
            if (Regex.IsMatch(token, "^[IVXLCM]+$", RegexOptions.IgnoreCase))
            {
                int num = RomanToInt(token.ToUpper());
                if (num > 0) return num + "ª generación";
            }
            // Numeric
            if (int.TryParse(token, out int n))
            {
                return n + "ª generación";
            }
            // English ordinals like 3rd -> 3
            var m = Regex.Match(token, "^(\\d+)");
            if (m.Success && int.TryParse(m.Groups[1].Value, out n)) return n + "ª generación";

            // Mark/Mk -> keep as-is
            return token;
        }

        private static int RomanToInt(string s)
        {
            if (string.IsNullOrEmpty(s)) return 0;
            var map = new Dictionary<char, int> {{'I',1},{'V',5},{'X',10},{'L',50},{'C',100},{'D',500},{'M',1000}};
            int total = 0; int prev = 0;
            for (int i = s.Length - 1; i >= 0; i--)
            {
                int val = map.ContainsKey(s[i]) ? map[s[i]] : 0;
                if (val < prev) total -= val; else { total += val; prev = val; }
            }
            return total;
        }

    }
