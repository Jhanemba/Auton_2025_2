        // Cuando el usuario cambia manualmente la puntuación
        private void NudPuntuacion_ValueChanged(object sender, EventArgs e)
        {
            // Mark that the user edited the puntuacion so automatic suggestions won't override
            usuarioEditoPuntuacion = true;
        }

        // Calcula y sugiere (o autollena) la puntuación en función de estrellas de seguridad y confiabilidad
        private void CalcularSugerenciaPuntuacion()
        {
            try
            {
                // Obtener estrellas a partir del ComboBox (mismo cálculo que en guardar)
                int estrellas = 0;
                if (cboSeguridadChoques != null && cboSeguridadChoques.SelectedIndex >= 0)
                {
                    int idx = cboSeguridadChoques.SelectedIndex;
                    estrellas = idx < 6 ? 5 - idx : 0; // índice 0 -> 5 estrellas, 5 -> 0 estrellas, 6 -> Sin calificación
                }

                // Mapeo básico: base según estrellas
                double baseScore = 6.0 + (estrellas * 0.8); // 0 estrellas -> 6.0, 5 estrellas -> 10.0

                // Modificador según confiabilidad
                double mod = 0.0;
                if (cboConfiabilidad != null && cboConfiabilidad.SelectedIndex >= 0)
                {
                    string conf = cboConfiabilidad.Text;
                    switch (conf)
                    {
                        case "Excelente":
                            mod = 1.0;
                            break;
                        case "Bueno":
                            mod = 0.0;
                            break;
                        case "Regular":
                            mod = -1.0;
                            break;
                        case "Malo":
                            mod = -2.0;
                            break;
                    }
                }

                double suggested = baseScore + mod;

                // Asegurar rango entre 1.0 y 10.0
                if (suggested > 10.0) suggested = 10.0;
                if (suggested < 1.0) suggested = 1.0;

                // Redondear a 0.5
                suggested = Math.Round(suggested * 2, MidpointRounding.AwayFromZero) / 2.0;

                if (nudPuntuacion != null)
                {
                    decimal valor = (decimal)suggested;
                    if (!usuarioEditoPuntuacion)
                    {
                        nudPuntuacion.Value = Math.Max(nudPuntuacion.Minimum, Math.Min(nudPuntuacion.Maximum, valor));
                    }
                    else
                    {
                        // Si el usuario ya modificó la puntuación, solo mostrar una sugerencia con tooltip
                        try
                        {
                            ttPuntuacion.Show($"Sugerencia: {suggested}", nudPuntuacion, 2000);
                        }
                        catch { }
                    }
                }
            }
            catch { }
        }

